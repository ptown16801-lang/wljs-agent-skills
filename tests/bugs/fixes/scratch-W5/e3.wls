$AllowInternet = False;
cnt[e_] := Module[{n = 0}, Internal`HandlerBlock[{"Assertions", (n++) &}, e]; n];
SetAttributes[cnt, HoldFirst];
Print["Off[Assert]; Assert[False] -> ", InputForm[Assert[False]]];
k = 0; tm[x_] := Block[{y}, y = x; Assert[(k++; y > 5)]; y];
cnt[tm[1]]; Print["test evals in handler call: ", k];
tm[1]; Print["test evals in plain call (k should stay 1 if skipped): ", k];
cnt[tm[1]]; Print["test evals in handler call after plain: ", k];
bm[x_] := Block[{y}, y = x^2; Assert[y > 5]; y];
reset := (bm[1]; If[cnt[bm[1]] =!= 0, Print["  (not stale!)"]]);
reset; Print["Block[{$AssertFunction}]: ", Block[{$AssertFunction}, cnt[bm[1]]], " after exit: ", cnt[bm[1]]];
reset; Print["Block[{$AssertFunction=$AssertFunction}]: ", Block[{$AssertFunction = $AssertFunction}, cnt[bm[1]]], " after exit: ", cnt[bm[1]]];
reset; Print["InheritedBlock[{$AssertFunction}] no assign: ", Internal`InheritedBlock[{$AssertFunction}, cnt[bm[1]]]];
reset; Print["InheritedBlock + reassign: ", Internal`InheritedBlock[{$AssertFunction}, $AssertFunction = $AssertFunction; cnt[bm[1]]], " after exit: ", cnt[bm[1]]];
reset; Print["Block[{$AssertFunction=f}]: ", Block[{$AssertFunction = (Null &)}, cnt[bm[1]]]];
reset; Print["plain call inside $AssertFunction block, then handler call in same block: ", Block[{$AssertFunction = $AssertFunction}, bm[1]; cnt[bm[1]]]];
reset; Print["Off[Assert] alone again: ", (Off[Assert]; cnt[bm[1]])];
reset; Print["On[Assert] inside: ", Block[{}, On[Assert]; With[{r = Quiet@cnt[bm[1]]}, Off[Assert]; r]]];
reset; Print["ClearSystemCache: ", (ClearSystemCache[]; cnt[bm[1]])];
reset; Print["Update[]: ", (Update[]; cnt[bm[1]])];
reset; Print["Update[bm]: ", (Update[bm]; cnt[bm[1]])];
reset; Print["Update[Assert]: ", (Update[Assert]; cnt[bm[1]])];
(* variants *)
v1[x_] := Block[{y}, Assert[x > 5]];
v2[x_] := With[{y = x}, Assert[y > 5]; y];
v3 = Function[x, Block[{y}, y = x; Assert[y > 5]; y]];
v4[x_] := Block[{y = x}, Assert[y > 5]; y];
v5[x_] := Block[{y}, y = x; If[True, Assert[y > 5]]; y];
v6[x_] := Module[{y}, y = x; Block[{z}, Assert[y > 5]]; y];
Do[With[{f = f}, Print[f, ": ", {cnt[f[1]], (f[1]; cnt[f[1]])}]], {f, {v1, v2, v3, v4, v5, v6}}];
