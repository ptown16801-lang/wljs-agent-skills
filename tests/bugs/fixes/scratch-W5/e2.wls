$AllowInternet = False;
cnt[e_] := Module[{n = 0}, Internal`HandlerBlock[{"Assertions", (n++) &}, e]; n];
SetAttributes[cnt, HoldFirst];
Print["opts: ", Select[Flatten[List @@@ SystemOptions[]], StringQ[#] && StringContainsQ[#, "ssert", IgnoreCase -> True] &]];
Print["sysopts containing Block: ", Select[Flatten[{SystemOptions[]} /. (a_ -> b_) :> a], StringQ[#] && StringContainsQ[#, "Block"] &]];
Print["Attributes Assert: ", Attributes[Assert], " Options ", Options[Assert]];
Print["$AssertFunction: ", $AssertFunction];
bm[x_] := Block[{y}, y = x^2; Assert[y > 5]; y];
Print["twice in handler: ", cnt[bm[1]], cnt[bm[1]]];
bm[10]; Print["after passing plain call: ", cnt[bm[1]]];
bm[x_] := Block[{y}, y = x^2; Assert[y > 5]; y];
Print["redefined: ", cnt[bm[1]]];
bm[1]; Print["after plain: ", cnt[bm[1]]];
DownValues[bm] = DownValues[bm]; Print["DownValues reassigned: ", cnt[bm[1]]];
DownValues[bm] = ReleaseHold[Hold[DownValues[bm]] /. {} -> {}] ; 
Print["copy via Uncompress/Compress: ", (DownValues[bm] = Uncompress[Compress[DownValues[bm]]]; cnt[bm[1]])];
bm[1]; On[Assert]; Off[Assert]; Print["after On/Off: ", cnt[bm[1]]];
bm[1]; Print["after plain: ", cnt[bm[1]]];
Block[{$AssertFunction = (Null &)}, Print["with $AssertFunction blocked: ", cnt[bm[1]]]];
Print["inside handler, with plain Block, Off: ", cnt[Block[{z}, z = 1; Assert[z > 5]]]];
