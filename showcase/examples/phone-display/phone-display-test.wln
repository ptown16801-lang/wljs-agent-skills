%-------------------------------------------------------------------------%
phonePlot = Plot[{Sin[x], Cos[x], Sin[2 x]/2}, {x, 0, 2 Pi}, PlotLegends -> Placed[{"sin x", "cos x", "sin 2x / 2"}, Below], PlotLabel -> "WLJS phone test (square)", AspectRatio -> 0.85, ImageSize -> 500]
phonePng = "~/Documents/Claude/mobile-display-test/wljs-plot-square.png";
phoneImg = Rasterize[phonePlot];
Export[phonePng, phoneImg];
{ImageDimensions[phoneImg], FileByteCount[phonePng]}

