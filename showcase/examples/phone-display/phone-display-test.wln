# Phone display test
A WLJS plot, rasterized to PNG so it can be shown on the phone with Claude's Read tool (Oct 24, 2026).

%-------------------------------------------------------------------------%
Props:
  Hidden: false
Type: Input
%-------------------------------------------------------------------------%
plot = Plot[{Sin[x], Cos[x], Sin[2 x]/2}, {x, 0, 2 Pi}, PlotLegends -> {"sin x", "cos x", "sin 2x / 2"}, PlotLabel -> "WLJS phone test", ImageSize -> 600]

%-------------------------------------------------------------------------%
Type: Output
%-------------------------------------------------------------------------%
(*VB[*)(Legended[ToExpression[FrontEndRef["F924995b1-8b20-456e-bb2e-3b222b24f86d"], InputForm], Placed[LineLegend[{Directive[Opacity[1.], RGBColor[0.24, 0.6, 0.8], AbsoluteThickness[2]], Directive[Opacity[1.], RGBColor[0.95, 0.627, 0.1425], AbsoluteThickness[2]], Directive[Opacity[1.], RGBColor[0.455, 0.7, 0.21], AbsoluteThickness[2]]}, {"sin x", "cos x", "sin 2x / 2"}, LegendMarkers -> None, LabelStyle -> {}, LegendLayout -> "Column"], After, Identity]])(*,*)(*"1:"*)(*]VB*)

%-------------------------------------------------------------------------%
Props:
  Hidden: false
Type: Input
%-------------------------------------------------------------------------%
png = "~/Documents/Claude/mobile-display-test/wljs-plot.png";
img = Rasterize[plot];
Export[png, img];
{ImageDimensions[img], FileByteCount[png]}

