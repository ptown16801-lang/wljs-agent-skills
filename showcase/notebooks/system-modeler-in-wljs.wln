  Hidden: false
Type: Input
%-------------------------------------------------------------------------%
.md
## A mechanical example from the Modelica Standard Library
`Modelica.Mechanics.Rotational.Examples.First`: a motor drives two inertias through a gearbox and an elastic shaft.

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
## A mechanical example from the Modelica Standard Library
`Modelica.Mechanics.Rotational.Examples.First`: a motor drives two inertias through a gearbox and an elastic shaft.

%-------------------------------------------------------------------------%
Props:
  Hidden: false
Type: Input
%-------------------------------------------------------------------------%
first`sim = SystemModelSimulate["Modelica.Mechanics.Rotational.Examples.First", 1];
{first`sim["inertia1.w", 1], SystemModelPlot[first`sim, {"inertia1.w", "inertia2.w", "inertia3.w"}, PlotRange -> All, PlotLegends -> {"inertia1.w", "inertia2.w", "inertia3.w"}]}

%-------------------------------------------------------------------------%
Type: Output
%-------------------------------------------------------------------------%
