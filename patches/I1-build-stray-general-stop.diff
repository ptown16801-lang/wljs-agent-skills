-buildDoc[srcFile_String] := Block[{info, tmpl, out},
+(* Each page is converted - and its examples evaluated - exactly ONCE: the
+   "Association" result carries the finished notebook as well as the template
+   and metadata the output path needs, and exportDeterministicNB (the writer
+   MarkdownToNotebook[src, file] itself uses) saves it with the same
+   deterministic ids. Converting a second time just to write the file ran every
+   example twice in this one kernel, so a message an example issues twice was
+   then issued a 3rd and 4th time and the 4th turned into a stray
+   "General::stop: Further output ... will be suppressed" cell on the page.
+   $MessageList is also Block-scoped per page, so General::stop counting starts
+   afresh for every page and one page's messages never suppress another's. *)
+buildDoc[srcFile_String] := Block[{info, tmpl, out, $MessageList = {}},
     info = MarkdownToNotebook[srcFile, "Association", "EvaluateSeparator" -> None];
     tmpl = info["Template"];
     out = outPath[tmpl, info["Metadata"]];
     Quiet @ CreateDirectory[DirectoryName[out], CreateIntermediateDirectories -> True];
-    MarkdownToNotebook[srcFile, out, "EvaluateSeparator" -> None];
+    exportDeterministicNB[out, info["Notebook"]];
     Print["  ", FileNameTake[srcFile], " (", tmpl, ") -> ", StringReplace[out, srcDocDir <> "/" -> ""]]
 ]
 
