+++ annotate-modelica-graphics/Schematic/libpins.py	2026-10-22 09:11:24.566071965 -0400
@@ -0,0 +1,577 @@
+"""Connector pin positions of library components, read from the installed library source.
+
+Routing needs to know where each connector of a standard-library component (MSL, or another
+library installed with System Modeler such as ``IntroductoryExamples``) sits on that
+component's icon. Instead of guessing it from the port name, this module opens the class's
+``.mo`` source in the System Modeler install (read-only), finds the connector's declaration —
+following ``extends`` clauses into partial base classes — and reads its
+``Placement(transformation(...), iconTransformation(...))``. ``iconTransformation`` wins when
+present, since it is what the icon (and so the enclosing diagram) shows.
+
+The connector point is the centre of the connector's placement box, mapped through the
+placement's ``origin``/``extent``/``rotation`` into the class's Icon coordinate system, and
+then normalised to the ±100 frame that an instance ``extent={{-10,-10},{10,10}}`` is drawn
+from. ``place()`` maps such a point onto an instance placement (extent incl. flips, origin,
+rotation), following the Modelica graphical-annotation rules.
+
+Library roots are located with ``scripts/wsm_run.py`` (same discovery as validate/simulate:
+``$WSM_HOME`` or the platform default install; MSL version from the model's
+``uses(Modelica(version=...))`` when installed, else the newest 4.x). Parsed files, classes
+and pins are cached per process. When a class, connector or placement cannot be found or
+parsed, ``pin_offset`` returns ``(None, reason)`` and the caller falls back to its name
+heuristic and records a warning — the fallback is never silent.
+"""
+
+from __future__ import annotations
+
+import math
+import os
+import re
+
+from .parser import ParseError, mask_code, find_classes, _split_statements, _strip_leading, \
+    _decl_type_and_names
+from mo_edit import balanced_close
+
+DEFAULT_CS = ((-100.0, -100.0), (100.0, 100.0))   # Modelica default coordinateSystem extent
+_MAX_DEPTH = 25                                    # extends-chain guard
+
+_NUM = r"[-+]?(?:\d+\.?\d*|\.\d+)(?:[eE][-+]?\d+)?"
+_PAIR = r"\{\s*(" + _NUM + r")\s*,\s*(" + _NUM + r")\s*\}"
+_EXTENT_RE = re.compile(r"\bextent\s*=\s*\{\s*" + _PAIR + r"\s*,\s*" + _PAIR + r"\s*\}")
+_EXTENT_OLD_RE = re.compile(r"\bextent\s*=\s*\[\s*(" + _NUM + r")\s*,\s*(" + _NUM + r")\s*;\s*("
+                            + _NUM + r")\s*,\s*(" + _NUM + r")\s*\]")
+_ORIGIN_RE = re.compile(r"\borigin\s*=\s*" + _PAIR)
+_ROTATION_RE = re.compile(r"\brotation\s*=\s*(" + _NUM + r")\s*(?=[,)]|$)")
+_USES_MSL_RE = re.compile(r"\buses\s*\(.*?\bModelica\s*\(\s*version\s*=\s*\"([^\"]+)\"", re.S)
+_NOT_TYPES = {"if", "elseif", "else", "for", "while", "when", "elsewhen", "then", "end", "der",
+              "connect", "assert", "terminate", "reinit", "return", "break", "external"}
+_IMPORT_RE = re.compile(r"\bimport\s+(?:(\w+)\s*=\s*)?([\w.]+?)(\.\*)?\s*;")
+
+# per-process state -----------------------------------------------------------------------
+_state = {"msl_version": None, "imports": {}, "wild": [], "roots": {}, "install": False}
+_FILES = {}      # path -> (text, mask, classes) or None
+_CLASSES = {}    # qualified name -> (path, idx) or None
+_PINS = {}       # (qualified class name, port) -> ((x, y), source) or (None, reason)
+_CS = {}         # qualified class name -> coordinate-system extent
+_IMPORTS = {}    # (path, class index) -> (imports, wildcard imports)
+_WARNINGS = []
+
+
+def configure(text: str) -> None:
+    """Read the user model's MSL version (``uses``) and its ``import`` clauses, so library
+    type names in the model resolve the way System Modeler resolves them."""
+    mask = mask_code(text)
+    m = _USES_MSL_RE.search(text)
+    version = m.group(1) if m else None
+    if version != _state["msl_version"]:
+        _state["roots"].clear()
+        _CLASSES.clear()
+        _PINS.clear()
+        _CS.clear()
+        _IMPORTS.clear()
+    _state["msl_version"] = version
+    imports, wild = {}, []
+    for im in _IMPORT_RE.finditer(mask):
+        alias, path, star = im.groups()
+        if star:
+            wild.append(path)
+        else:
+            imports[alias or path.split(".")[-1]] = path
+    _state["imports"], _state["wild"] = imports, wild
+
+
+def warn(msg: str) -> None:
+    if msg not in _WARNINGS:
+        _WARNINGS.append(msg)
+
+
+def take_warnings() -> list:
+    """Return and clear the library-level warnings collected so far."""
+    out = list(_WARNINGS)
+    del _WARNINGS[:]
+    return out
+
+
+# ---------------------------------------------------------------------------
+# geometry
+# ---------------------------------------------------------------------------
+
+def place(pt, extent, origin=(0.0, 0.0), rotation=0.0, cs=DEFAULT_CS) -> tuple:
+    """Map ``pt`` from a class's coordinate system ``cs`` onto a Placement transformation.
+
+    Modelica semantics: the class's coordinate-system extent is mapped onto ``extent``
+    (a reversed corner order flips that axis), the result is rotated ``rotation`` degrees
+    counter-clockwise about the local origin, then translated by ``origin``.
+    """
+    (cx1, cy1), (cx2, cy2) = cs
+    (ex1, ey1), (ex2, ey2) = extent
+    u = (pt[0] - cx1) / (cx2 - cx1)
+    v = (pt[1] - cy1) / (cy2 - cy1)
+    x = ex1 + u * (ex2 - ex1)
+    y = ey1 + v * (ey2 - ey1)
+    r = rotation % 360
+    if r == 0:
+        rx, ry = x, y
+    elif r == 90:
+        rx, ry = -y, x
+    elif r == 180:
+        rx, ry = -x, -y
+    elif r == 270:
+        rx, ry = y, -x
+    else:
+        a = math.radians(r)
+        rx, ry = x * math.cos(a) - y * math.sin(a), x * math.sin(a) + y * math.cos(a)
+    return (origin[0] + rx, origin[1] + ry)
+
+
+def _normalise(pt, cs) -> tuple:
+    """Point in coordinate system ``cs`` -> the ±100 frame an instance extent is drawn from."""
+    x, y = place(pt, ((-100.0, -100.0), (100.0, 100.0)), cs=cs)
+    return (round(x, 4), round(y, 4))
+
+
+# ---------------------------------------------------------------------------
+# locating library sources
+# ---------------------------------------------------------------------------
+
+def _install_root():
+    if _state["install"] is False:
+        try:
+            import wsm_run                        # scripts/ is on sys.path via .parser
+            _state["install"] = wsm_run.find_install()[0]
+        except Exception as e:                    # no install, no kernel, import failure
+            warn("System Modeler install not found (%s); library pin positions cannot be "
+                 "read from source" % str(e).splitlines()[0])
+            _state["install"] = None
+    return _state["install"]
+
+
+def _library_root(top: str):
+    """Directory (holding package.mo) or single .mo file of top-level library ``top``."""
+    if top in _state["roots"]:
+        return _state["roots"][top]
+    found = None
+    root = _install_root()
+    if root:
+        try:
+            import wsm_run
+            msl_dir = None
+            try:
+                msl = wsm_run.find_msl(root, _state["msl_version"])
+            except RuntimeError as e:
+                warn("%s; using the default MSL version instead" % str(e).splitlines()[0])
+                msl = wsm_run.find_msl(root)
+            if msl:
+                msl_dir = os.path.dirname(os.path.dirname(msl["modelica"]))
+            if top == "Modelica" and msl:
+                found = os.path.dirname(msl["modelica"])
+            elif msl_dir and os.path.isfile(os.path.join(msl_dir, top, "package.mo")):
+                found = os.path.join(msl_dir, top)          # e.g. ModelicaServices
+            elif msl_dir and os.path.isfile(os.path.join(msl_dir, top + ".mo")):
+                found = os.path.join(msl_dir, top + ".mo")  # e.g. Complex
+            else:
+                pkg = wsm_run.resolve_library(root, top)
+                if pkg and pkg.endswith(".mo"):              # .moe is encrypted: unreadable
+                    found = os.path.dirname(pkg)
+        except Exception:
+            found = None
+    _state["roots"][top] = found
+    return found
+
+
+def _load(path: str):
+    if path not in _FILES:
+        try:
+            with open(path, "r", encoding="utf-8", errors="replace") as f:
+                text = f.read().replace("\r\n", "\n").replace("\r", "\n")
+            mask = mask_code(text)
+            classes = find_classes(text, mask)
+            _FILES[path] = (text, mask, classes, _nested_in_parens(mask, classes))
+        except (OSError, ParseError):
+            _FILES[path] = None
+    return _FILES[path]
+
+
+def _nested_in_parens(mask: str, classes: list) -> set:
+    """Indices of 'classes' whose header sits inside parentheses — a modification such as
+    ``ports(redeclare package Medium = Medium)``, not a class definition. The shared parser
+    reports those as short classes; they must not hide the declaration around them."""
+    starts = sorted((c.header_start, i) for i, c in enumerate(classes))
+    out, depth, k = set(), 0, 0
+    for m in re.finditer(r"[()\[\]{}]", mask):
+        while k < len(starts) and starts[k][0] < m.start():
+            if depth > 0:
+                out.add(starts[k][1])
+            k += 1
+        depth += 1 if m.group() in "([{" else -1
+    return out
+
+
+def _children(path: str, idx: int) -> list:
+    _, _, classes, bogus = _load(path)
+    return [ci for ci in classes[idx].children if ci not in bogus]
+
+
+def _top(path: str, name: str):
+    f = _load(path)
+    if not f:
+        return None
+    for i, c in enumerate(f[2]):
+        if c.parent == -1 and c.name == name and i not in f[3]:
+            return (path, i)
+    return None
+
+
+def _child(ref, name: str):
+    if not ref:
+        return None
+    path, idx = ref
+    classes = _load(path)[2]
+    for ci in _children(path, idx):
+        if classes[ci].name == name:
+            return (path, ci)
+    return None
+
+
+def _find_class(qname: str):
+    """(path, class index) of fully qualified class ``qname``, or None."""
+    if qname in _CLASSES:
+        return _CLASSES[qname]
+    segs = qname.split(".")
+    ref = None
+    root = _library_root(segs[0])
+    if root:
+        if os.path.isdir(root):
+            cur_dir = root
+            ref = _top(os.path.join(root, "package.mo"), segs[0])
+        else:
+            cur_dir = None
+            ref = _top(root, segs[0])
+        for s in segs[1:]:
+            if ref is None:
+                break
+            if cur_dir is not None and os.path.isfile(os.path.join(cur_dir, s + ".mo")):
+                ref, cur_dir = _top(os.path.join(cur_dir, s + ".mo"), s), None
+            elif cur_dir is not None and os.path.isfile(os.path.join(cur_dir, s, "package.mo")):
+                cur_dir = os.path.join(cur_dir, s)
+                ref = _top(os.path.join(cur_dir, "package.mo"), s)
+            else:
+                ref, cur_dir = _child(ref, s), None
+    _CLASSES[qname] = ref
+    return ref
+
+
+def _class_statements(ref):
+    """Yield (masked statement, statement start) for the class's own body."""
+    path, idx = ref
+    text, mask, classes, _ = _load(path)
+    cls = classes[idx]
+    # own body minus real nested classes (cf. parser._own_intervals, without the bogus ones)
+    spans = sorted((classes[c].header_start, classes[c].full_end) for c in _children(path, idx))
+    intervals, cur = [], cls.body_start
+    for s, e in spans:
+        if s > cur:
+            intervals.append((cur, s))
+        cur = max(cur, e)
+    if cur < cls.body_end:
+        intervals.append((cur, cls.body_end))
+    for (a, b) in intervals:
+        for (s, e) in _split_statements(mask, a, b):
+            yield mask[s:e + 1], s
+
+
+def _short_base(ref):
+    """Base of a short class definition ``model X = Base(...)``, or None."""
+    path, idx = ref
+    text, mask, classes, _ = _load(path)
+    c = classes[idx]
+    m = re.match(r"\s*(?:input\s+|output\s+)?([\w.]+)",
+                 mask[mask.index("=", c.header_start) + 1:c.full_end]) \
+        if c.full_end == c.body_end + 1 else None
+    return m.group(1) if m else None
+
+
+def _imports_of(ref) -> tuple:
+    if ref in _IMPORTS:
+        return _IMPORTS[ref]
+    imports, wild = {}, []
+    for st, _ in _class_statements(ref):
+        core = st[_strip_leading(st):].lstrip()
+        if core.startswith("import"):
+            m = _IMPORT_RE.match(core)
+            if m:
+                alias, path, star = m.groups()
+                if star:
+                    wild.append(path)
+                else:
+                    imports[alias or path.split(".")[-1]] = path
+    _IMPORTS[ref] = (imports, wild)
+    return imports, wild
+
+
+def _lookup(name: str, scope: str):
+    """Resolve a (possibly relative) class name as seen from class ``scope``.
+    Returns the fully qualified name, or None."""
+    if name.startswith("."):
+        name = name[1:]
+    first, _, rest = name.partition(".")
+    tail = ("." + rest) if rest else ""
+    segs = scope.split(".") if scope else []
+    while segs:
+        s = ".".join(segs)
+        if _find_class(s + "." + first):
+            return s + "." + first + tail if _find_class(s + "." + first + tail) else None
+        ref = _find_class(s)
+        if ref:
+            imports, wild = _imports_of(ref)
+            if first in imports:
+                full = imports[first] + tail
+                return full if _find_class(full) else None
+            for w in wild:
+                if _find_class(w + "." + first):
+                    return w + "." + first + tail if _find_class(w + "." + first + tail) else None
+        segs.pop()
+    return name if _find_class(name) else None
+
+
+def _resolve_user_type(type_name: str, scope: str | None = None):
+    """Fully qualified library class for a type name written in the user's model.
+
+    ``scope`` is the qualified name of the class being laid out (``within`` prefix + class
+    path), so a relative name such as ``Components.Valve`` written inside an installed
+    library's package resolves the way Modelica lookup does (enclosing scopes outward)."""
+    first, _, rest = type_name.partition(".")
+    tail = ("." + rest) if rest else ""
+    if first in _state["imports"]:
+        full = _state["imports"][first] + tail
+        if _find_class(full):
+            return full
+    for w in _state["wild"]:
+        if _find_class(w + "." + type_name):
+            return w + "." + type_name
+    if scope:
+        full = _lookup(type_name, scope)
+        if full:
+            return full
+    return type_name if _find_class(type_name) else None
+
+
+def within_prefix(text: str) -> str:
+    """The ``within`` clause of a file ('' when absent or ``within;``)."""
+    m = re.match(r"\s*within\s+([\w.]+)\s*;", mask_code(text))
+    return m.group(1) if m else ""
+
+
+# ---------------------------------------------------------------------------
+# placements
+# ---------------------------------------------------------------------------
+
+def _call_body(s: str, pattern: str, top: bool = False):
+    """Text inside the first ``kw(...)`` matching ``pattern`` (which ends at the '('), or None.
+    With ``top``, only an element at bracket depth 0 of ``s`` counts (not the value of a
+    named entry) — so ``Icon(`` in a vendor entry such as ``ModelEditor = Icon(list(...))``
+    is not mistaken for the real one."""
+    if s is None:
+        return None
+    depth, pos = 0, 0
+    for m in re.finditer(pattern, s):
+        if top:
+            for ch in s[pos:m.start()]:
+                if ch in "([{":
+                    depth += 1
+                elif ch in ")]}":
+                    depth -= 1
+            pos = m.start()
+            if depth != 0 or s[:m.start()].rstrip().endswith("="):
+                continue
+        close = balanced_close(s, m.end() - 1)
+        return s[m.end():close] if close != -1 else None
+    return None
+
+
+def _annotation(stmt: str):
+    """Body of a statement's own (depth-0) ``annotation(...)``, or None."""
+    return _call_body(stmt, r"\bannotation\s*\(", top=True)
+
+
+def _extent(s: str):
+    m = _EXTENT_RE.search(s) or _EXTENT_OLD_RE.search(s)
+    if not m:
+        return None
+    x1, y1, x2, y2 = (float(v) for v in m.groups())
+    return ((x1, y1), (x2, y2))
+
+
+def _transformation_point(body: str):
+    """Connector-box centre of one ``transformation(...)`` body, in the parent class frame.
+    Returns (point, None) or (None, reason)."""
+    ext = _extent(body)
+    if ext is None:
+        return None, "placement extent is not numeric"
+    om = _ORIGIN_RE.search(body)
+    origin = (float(om.group(1)), float(om.group(2))) if om else (0.0, 0.0)
+    if re.search(r"\borigin\s*=", body) and not om:
+        return None, "placement origin is not numeric"
+    rm = _ROTATION_RE.search(body)
+    if re.search(r"\brotation\s*=", body) and not rm:
+        return None, "placement rotation is not numeric"
+    rotation = float(rm.group(1)) if rm else 0.0
+    # The box centre is the image of the connector's own (symmetric) coordinate-system centre.
+    return place((0.0, 0.0), ext, origin, rotation), None
+
+
+def _placement_point(stmt: str):
+    """Connector point from a declaration's ``Placement`` annotation: (point, src) or
+    (None, reason). ``iconTransformation`` is preferred (what the icon shows)."""
+    body = _call_body(_annotation(stmt), r"\bPlacement\s*\(", top=True)
+    if body is None:
+        return None, "connector declaration has no Placement"
+    it = _call_body(body, r"\biconTransformation\s*\(", top=True)
+    if it is not None:
+        pt, why = _transformation_point(it)
+        return pt, why or "iconTransformation"
+    tr = _call_body(body, r"(?<![\w])transformation\s*\(", top=True)
+    if tr is None:
+        return None, "Placement has no transformation"
+    pt, why = _transformation_point(tr)
+    return pt, why or "transformation"
+
+
+def _class_cs(qname: str, depth: int = 0):
+    """Icon coordinate-system extent of a class (own, else first base that has one)."""
+    if qname in _CS:
+        return _CS[qname]
+    cs = None
+    ref = _find_class(qname)
+    if ref and depth < _MAX_DEPTH:
+        bases = []
+        for st, _ in _class_statements(ref):
+            core = st[_strip_leading(st):].lstrip()
+            if core.startswith("annotation"):
+                icon = _call_body(_annotation(core), r"\bIcon\s*\(", top=True)
+                csb = _call_body(icon, r"\bcoordinateSystem\s*\(", top=True)
+                cs = _extent(csb) if csb else None
+            elif core.startswith("extends"):
+                m = re.match(r"extends\s+([\w.]+)", core)
+                if m:
+                    bases.append(m.group(1))
+        sb = _short_base(ref)
+        if sb:
+            bases.append(sb)
+        if cs is None:
+            for b in bases:
+                full = _lookup(b, qname)
+                if full and full != qname:
+                    cs = _class_cs(full, depth + 1)
+                    if cs != DEFAULT_CS:
+                        break
+    if cs is None or cs[0][0] == cs[1][0] or cs[0][1] == cs[1][1]:
+        cs = DEFAULT_CS
+    _CS[qname] = cs
+    return cs
+
+
+def _find_pin(qname: str, port: str, depth: int = 0):
+    """((x, y) in ``qname``'s icon frame, source) or (None, reason), following extends."""
+    key = (qname, port)
+    if key in _PINS:
+        return _PINS[key]
+    ref = _find_class(qname)
+    if ref is None:
+        return None, "class %s not found in the installed libraries" % qname
+    if depth > _MAX_DEPTH:
+        return None, "extends chain too deep at %s" % qname
+    result = None
+    bases = []
+    path = ref[0]
+    for st, start in _class_statements(ref):
+        core = st[_strip_leading(st):].lstrip()
+        if core.startswith("extends"):
+            m = re.match(r"extends\s+([\w.]+)", core)
+            if m:
+                imap = _call_body(_annotation(core), r"\bIconMap\s*\(", top=True)
+                bases.append((m.group(1), _extent(imap) if imap else None))
+            continue
+        if core.startswith(("import", "annotation", "connect")):
+            continue
+        type_name, names, _ = _decl_type_and_names(core)
+        if type_name in _NOT_TYPES:
+            continue
+        if port in [n.strip("'") for n in names]:
+            pt, src = _placement_point(st)
+            line = _load(path)[0].count("\n", 0, start + len(st) - len(st.lstrip())) + 1
+            where = "%s:%d" % (_short_path(path), line)
+            result = (pt, "%s %s of %s" % (where, src, qname)) if pt else \
+                (None, "%s: %s (%s)" % (where, src, qname))
+            break
+    if result is None:
+        sb = _short_base(ref)
+        if sb:
+            bases.append((sb, None))
+        why = "connector %r not declared in %s or its base classes" % (port, qname)
+        for b, imap_extent in bases:
+            full = _lookup(b, qname)
+            if not full:
+                why = "base class %s of %s not found in the installed libraries" % (b, qname)
+                continue
+            if full == qname:
+                continue
+            pt, src = _find_pin(full, port, depth + 1)
+            if pt is not None:
+                if imap_extent is not None:   # base icon drawn into a sub-extent (IconMap)
+                    pt = place(pt, imap_extent, cs=_class_cs(full))
+                result = (pt, src)
+                break
+            if not src.startswith("connector "):
+                why = src                    # a real parse problem beats "not declared"
+        if result is None:
+            result = (None, why)
+    _PINS[key] = result
+    return result
+
+
+def _short_path(path: str) -> str:
+    parts = os.path.normpath(path).split(os.sep)
+    for i, p in enumerate(parts):
+        if p == "L" and i + 1 < len(parts):
+            return "/".join(parts[i + 1:])
+    return path
+
+
+def pin_offset(type_name: str, port: str, local_extends: dict | None = None,
+               scope: str | None = None, _depth: int = 0) -> tuple:
+    """Connector ``port`` of library type ``type_name`` in the ±100 icon frame.
+
+    Returns ((px, py), source) on success, or (None, reason). ``local_extends`` maps the
+    model's own (in-file) class names to their ``extends`` lists, so an in-file class that
+    inherits its connectors from a library base is resolved through that base. ``scope``
+    is the qualified name of the class being laid out, for relative type names.
+    """
+    port = re.sub(r"\[[^\]]*\]", "", port).split(".")[0].strip("'")
+    why = None
+    if local_extends and type_name in local_extends and _depth < _MAX_DEPTH:
+        reasons = []
+        for base in local_extends[type_name]:
+            pt, src = pin_offset(base, port, local_extends, scope, _depth + 1)
+            if pt is not None:
+                return pt, src
+            if not base.startswith("Modelica.Icons."):
+                reasons.append(src)
+        why = ("in-file class %s: connector %r is not placed by the model's own icon%s"
+               % (type_name, port, (" (bases: %s)" % "; ".join(reasons)) if reasons else ""))
+    qname = _resolve_user_type(type_name, scope)
+    if qname is None:
+        if why:
+            return None, why
+        if _install_root() is None:
+            return None, "System Modeler install not found"
+        return None, "class %s not found in the installed libraries" % type_name
+    ref = _find_class(qname)
+    if _load(ref[0])[2][ref[1]].kind == "connector":
+        # the 'component' is itself a connector (e.g. an expandable bus placed in the
+        # diagram): a connection to it or to one of its members ends at its centre
+        return (0.0, 0.0), "centre of connector instance (%s)" % qname
+    pt, src = _find_pin(qname, port)
+    if pt is None:
+        return None, why or src
+    return _normalise(pt, _class_cs(qname)), src
